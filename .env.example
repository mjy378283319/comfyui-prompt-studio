# ── 基础 ──────────────────────────────────────────────
DATA_DIR=/app/data
PORT=8199

# ── 登录与公网安全 ────────────────────────────────────
# 留空 = 首次在内网直连访问 /login 自行创建管理员（推荐）
# 设置后跳过首次设置；至少 8 位，不要纯数字或纯字母
# APP_PASSWORD=换成你的口令
APP_USERNAME=admin
# 会话有效期（天），每次访问滑动续期
SESSION_TTL_DAYS=30
# 挂在 Lucky / Nginx 反代后面时保持 true（读取 X-Forwarded-*）
TRUST_PROXY=true
# 公网部署强烈建议设为 true：外部是 http 时强制 308 跳转 https
REQUIRE_HTTPS=false
# 是否允许公网来源创建首个管理员，默认 false
ALLOW_PUBLIC_SETUP=false
# 登录失败锁定阈值与锁定时长（分钟）
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=5
# 需要跨站调用 API 时才填，多个用逗号分隔；留空 = 严格同源
# ALLOWED_ORIGINS=https://prompt.example.com

# ── ComfyUI（B 房，经 A 房 frp 隧道）─────────────────
# 容器内 127.0.0.1 指向自己，绝不能填 127.0.0.1
# 18189 = cu130 / Z-Image INT8（主用）；18188 = 秋叶包 GGUF
COMFYUI_URL=http://host.docker.internal:18189
# ComfyUI 开了 --auth 时把凭据写进 URL（不要提交到仓库）：
# COMFYUI_URL=http://comfyuser:你的强密码@host.docker.internal:18189

# 出图引擎：zimage-int8 / zimage-gguf / sd（默认 sd，保持旧行为）
WORKFLOW_ENGINE=zimage-int8

# ── 出图自动归档 ─────────────────────────────────────
# 图片写入 DATA_DIR/gallery/YYYYMM/，复用现有持久化卷
GALLERY_ENABLED=true
GALLERY_POLL_INTERVAL=8
GALLERY_INIT_MODE=from_now
GALLERY_HISTORY_LIMIT=64
GALLERY_TIMEOUT=15
GALLERY_MAX_IMAGE_MB=20
# 0 = 不自动淘汰；填数字则保留最近 N 条，超出部分连图片一起删除
GALLERY_MAX_ITEMS=0
TZ=Asia/Shanghai

# ── 姿势参考库（可选只读挂载）────────────────────────
# 把 anhao/ai-pose-gallery-zh 挂到该目录；镜像不含任何上游数据与图片
REFERENCE_DIR=/app/reference
POSE_REFERENCE_ENABLED=true
# 成人模式默认关闭；开启后仍需登录 + 内网直连 + 界面二次确认，重启自动回到 SFW
POSE_ADULT_MODE=false
# 默认首页：studio=AI 角色合成台（与上游 Studio 一致），workbench=四层工作台
DEFAULT_VIEW=studio

# ── 反推引擎 ──────────────────────────────────────────
MODEL_DIR=/app/models/wd14
WD14_THRESHOLD=0.35
# REMOTE_VISION_URL=https://your-api.example.com/v1/chat/completions
# REMOTE_VISION_KEY=
# REMOTE_VISION_MODEL=gpt-4o-mini
# REMOTE_VISION_MODE=openai
# REMOTE_VISION_TIMEOUT=45

# ── Unraid 卷属主 ─────────────────────────────────────
PUID=99
PGID=100
