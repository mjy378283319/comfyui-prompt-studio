<?xml version="1.0" encoding="utf-8"?>
<!--
  Unraid Docker 模板：把本文件放到
  /boot/config/plugins/dockerMan/templates-user/comfyui-prompt-studio.xml
  然后在 Docker 页点「添加容器」→ 模板下拉里选 ComfyUI Prompt Studio。
  COMFYUI_URL 默认指向 A 房 frp 隧道端口 18189（B 房 cu130 / Z-Image INT8）；
  若 ComfyUI 就在同一台 NAS 上，改回 8188。容器内 127.0.0.1 不能指向宿主机。
  APP_PASSWORD 留空时，首次在内网直连访问 http://<NAS-IP>:8199/login 自行创建管理员；
  也可直接填入口令（至少 8 位）跳过首次设置。
-->
<Container version="2">
  <Name>comfyui-prompt-studio</Name>
  <Repository>ghcr.io/mjy378283319/comfyui-prompt-studio:latest</Repository>
  <Registry>https://ghcr.io</Registry>
  <Network>bridge</Network>
  <Privileged>false</Privileged>
  <Support>https://github.com/mjy378283319/comfyui-prompt-studio/issues</Support>
  <Project>https://github.com/mjy378283319/comfyui-prompt-studio</Project>
  <Overview>ComfyUI 提示词工作台：四层模块化模板、图片反推提示词、tag 与自然语言双模式输出，支持 Z-Image-Turbo 一键出图，并把 ComfyUI 生成的图片自动归档到持久化卷，随时查看 / 搜索 / 复用提示词。内置登录页、会话保护与失败锁定，纯 Python 标准库，镜像极小。首次使用在内网创建管理员，或用 APP_PASSWORD 预设口令。</Overview>
  <Category>Tools:AI Media:</Category>
  <WebUI>http://[IP]:[PORT:8199]/</WebUI>
  <ExtraParams>--add-host=host.docker.internal:host-gateway</ExtraParams>
  <Networking>
    <Mode>bridge</Mode>
    <Publish>
      <Port>
        <HostPort>8199</HostPort>
        <ContainerPort>8199</ContainerPort>
        <Protocol>tcp</Protocol>
      </Port>
    </Publish>
  </Networking>
  <Data>
    <Volume>
      <HostDir>/mnt/user/appdata/comfyui-prompt-studio/data</HostDir>
      <ContainerDir>/app/data</ContainerDir>
      <Mode>rw</Mode>
    </Volume>
    <Volume>
      <HostDir>/mnt/user/appdata/comfyui-prompt-studio/models</HostDir>
      <ContainerDir>/app/models/wd14</ContainerDir>
      <Mode>rw</Mode>
    </Volume>
    <Volume>
      <HostDir>/mnt/user/appdata/ai-pose-gallery-zh</HostDir>
      <ContainerDir>/app/reference</ContainerDir>
      <Mode>ro</Mode>
    </Volume>
  </Data>
  <Environment>
    <Variable>
      <Name>PUID</Name>
      <Value>99</Value>
      <Mode/>
    </Variable>
    <Variable>
      <Name>PGID</Name>
      <Value>100</Value>
      <Mode/>
    </Variable>
    <Variable>
      <Name>PORT</Name>
      <Value>8199</Value>
      <Mode/>
    </Variable>
    <!-- 18189 = B 房 cu130 / Z-Image INT8；18188 = 秋叶包 GGUF。
         ComfyUI 开启鉴权时写成 http://用户名:密码@host.docker.internal:18189 -->
    <Variable>
      <Name>COMFYUI_URL</Name>
      <Value>http://host.docker.internal:18189</Value>
      <Mode/>
    </Variable>
    <Variable>
      <Name>WORKFLOW_ENGINE</Name>
      <Value>zimage-int8</Value>
      <Mode/>
    </Variable>
    <!-- 出图自动归档：图片写入已持久化的 /app/data/gallery/，无需新增卷 -->
    <Variable>
      <Name>GALLERY_ENABLED</Name>
      <Value>true</Value>
      <Mode/>
    </Variable>
    <Variable>
      <Name>GALLERY_POLL_INTERVAL</Name>
      <Value>8</Value>
      <Mode/>
    </Variable>
    <Variable>
      <Name>GALLERY_INIT_MODE</Name>
      <Value>from_now</Value>
      <Mode/>
    </Variable>
    <Variable>
      <Name>TZ</Name>
      <Value>Asia/Shanghai</Value>
      <Mode/>
    </Variable>
    <Variable>
      <Name>WD14_THRESHOLD</Name>
      <Value>0.35</Value>
      <Mode/>
    </Variable>
    <Variable>
      <Name>APP_USERNAME</Name>
      <Value>admin</Value>
      <Mode/>
    </Variable>
    <Variable>
      <Name>APP_PASSWORD</Name>
      <Value></Value>
      <Mode/>
    </Variable>
    <Variable>
      <Name>SESSION_TTL_DAYS</Name>
      <Value>30</Value>
      <Mode/>
    </Variable>
    <Variable>
      <Name>TRUST_PROXY</Name>
      <Value>true</Value>
      <Mode/>
    </Variable>
    <Variable>
      <Name>REQUIRE_HTTPS</Name>
      <Value>false</Value>
      <Mode/>
    </Variable>
    <Variable>
      <Name>ALLOW_PUBLIC_SETUP</Name>
      <Value>false</Value>
      <Mode/>
    </Variable>
    <Variable>
      <Name>REFERENCE_DIR</Name>
      <Value>/app/reference</Value>
      <Mode/>
    </Variable>
    <Variable>
      <Name>POSE_REFERENCE_ENABLED</Name>
      <Value>true</Value>
      <Mode/>
    </Variable>
    <Variable>
      <Name>POSE_ADULT_MODE</Name>
      <Value>false</Value>
      <Mode/>
    </Variable>
    <Variable>
      <Name>DEFAULT_VIEW</Name>
      <Value>studio</Value>
      <Mode/>
    </Variable>
  </Environment>
  <Labels/>
  <Shell>sh</Shell>
  <PostArgs/>
  <CPUset/>
  <DateInstalled/>
  <DonateLink/>
  <Requires/>
</Container>
